{
  "name": "OneTerminal",
  "version": "1.0.0",
  "description": "Терминал для интеграции в поле HTML документа внутри 1С",
  "main": "index.js",
  "scripts": {
    "start": "webpack serve --config webpack/webpack.dev.js",
    "build": "npm run clean && cross-env NODE_ENV=production webpack --config webpack/webpack.prod.js",
    "clean": "rimraf dist",
    "format": "prettier --cache --write '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "format:diff": "prettier --cache --list-different '**/*.{js,css,md,mdx,ts,tsx,yml}'",
    "lint": "eslint '**/*.{js,ts,tsx,md,mdx}' --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "testreport": "playwright show-report",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:1c": "playwright test e2e/1c-html.spec.ts",
    "tscheck": "tsc",
    "tscheck:watch": "tsc -w"
  },
  "browserslist": {
    "production": [
      "safari >=5, ie >=6, firefox >=5, chrome >=32",
      "ie 11",
      "chrome 32",
      "firefox 5",
      "safari 5"
    ],
    "development": [
      "safari >=5, ie >=6, firefox >=5, chrome >=32",
      "ie 11",
      "chrome 32",
      "firefox 5",
      "safari 5"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/plugin-transform-modules-commonjs": "^7.23.3",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.10.2",
    "babel-core": "^6.26.3",
    "babel-loader": "^9.1.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "babel-plugin-preval": "^5.1.0",
    "babel-plugin-transform-commonjs": "^1.1.6",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-plugin-transform-replace-expressions": "^0.2.0",
    "copy-webpack-plugin": "latest",
    "core-js": "^3.36.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.5.3",
    "json-minimizer-webpack-plugin": "^4.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "normalize.css": "^8.0.1",
    "postcss-loader": "^7.3.3",
    "postcss-preset-env": "^9.3.0",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "terser-webpack-plugin": "^5.3.9",
    "typescript": "^5.9.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.10.0"
  },
  "author": "https://github.com/LevkinSergey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LevkinSergey/OneTerminal.git"
  },
  "bugs": {
    "url": "https://github.com/LevkinSergey/OneTerminal/issues"
  },
  "keywords": [
    "terminal",
    "1c",
    "typescript",
    "scss"
  ],
  "dependencies": {
    "keyboardevent-key-polyfill": "^1.1.0",
    "xterm": "^3.14.5",
    "xterm-addon-web-links": "^0.1.0"
  }
}